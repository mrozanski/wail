{
  "name": "wail",
  "version": "0.1.0",
  "description": "WAIL (\"What Am I Looking At\") — local-first CLI that turns Markdown into an AI-assisted standalone HTML reader.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wail": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p reader/tsconfig.json"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "hast-util-to-html": "^9.0.0",
    "mdast-util-to-hast": "^13.2.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
